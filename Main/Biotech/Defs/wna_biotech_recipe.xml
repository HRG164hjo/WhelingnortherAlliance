  <RecipeDef ParentName="WNA_RecipeBase">
    <defName>WNA_RecyecleWastepack</defName>
    <label>recycle wastepack</label>
    <description>treat wastepacks with strong heat to recycle resources.</description>
    <jobString>recycling waste pack.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Wastepack</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Wastepack</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Uranium>2</Uranium>
      <WNA_MercuryVial>3</WNA_MercuryVial>
      <WNA_HalogenVial>5</WNA_HalogenVial>
    </products>
    <workAmount>450</workAmount>
    <recipeUsers>
      <li>ElectricSmelter</li>
      <li>ElectricCrematorium</li>
    </recipeUsers>
    <researchPrerequisites>
      <li>WNA_CivilianTech</li>
    </researchPrerequisites>
  </RecipeDef>
