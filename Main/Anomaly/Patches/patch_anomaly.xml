<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationReplace">
	    <xpath>Defs/HediffDef[defName="VoidTouched"]/renderNodeProperties/li[@Class="PawnRenderNodeProperties_Eye"]/texPath</xpath>
        <value>
            <texPath>pawns/alt_eye/grayeye</texPath>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
	    <xpath>Defs/HediffDef[defName="VoidTouched"]/renderNodeProperties/li[@Class="PawnRenderNodeProperties_Eye"]/texPathFemale</xpath>
        <value>
            <texPathFemale>pawns/alt_eye/grayeye</texPathFemale>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationReplace">
	    <xpath>Defs/TraitDef[defName="BodyMastery"]/degreeDatas/li/renderNodeProperties/li[@Class="PawnRenderNodeProperties_Eye"]/texPath</xpath>
        <value>
            <texPath>pawns/alt_eye/grayeye</texPath>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
	    <xpath>Defs/TraitDef[defName="BodyMastery"]/degreeDatas/li/renderNodeProperties/li[@Class="PawnRenderNodeProperties_Eye"]/texPathFemale</xpath>
        <value>
            <texPathFemale>pawns/alt_eye/grayeye</texPathFemale>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
	    <xpath>Defs/ThingDef[defName="Bioferrite"]</xpath>
        <value>
            <deepCommonality>0.5</deepCommonality>
            <deepCountPerPortion>45</deepCountPerPortion>
            <deepLumpSizeRange>7~8</deepLumpSizeRange>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationRemove">
	    <xpath>Defs/StatDef[defName="ActivitySuppressionRate"]/statFactors</xpath>
    </Operation>

    <Operation Class="PatchOperationAdd">
	    <xpath>Defs/ThingDef[defName="ShardBeacon"]</xpath>
        <value>
            <useHitPoints>false</useHitPoints>
            <stealable>false</stealable>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
	    <xpath>Defs/ThingDef[defName="ShardBeacon"]/comps/li[@Class="CompProperties_Facility"]</xpath>
        <value>
            <li Class="CompProperties_Facility">
                <statOffsets>
                    <PsychicRitualQuality>0.25</PsychicRitualQuality>
                </statOffsets>
                <maxSimultaneous>4</maxSimultaneous>
                <maxDistance>10</maxDistance>
            </li>
        </value>
    </Operation>
</Patch>