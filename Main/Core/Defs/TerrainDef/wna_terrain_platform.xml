<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <DesignatorDropdownGroupDef>
    <defName>WNA_FloorGroup_Platform</defName>
    <label>wna terrain</label>
  </DesignatorDropdownGroupDef>
  <DesignatorDropdownGroupDef>
    <defName>WNA_FloorGroup_Platform_Focus</defName>
    <label>wna terrain (focus)</label>
  </DesignatorDropdownGroupDef>

  <TerrainDef ParentName="WNA_FloorsBase">
    <defName>WNA_PlatformFloor</defName>
    <label>structure platform</label>
    <description>Platform built with reinforced structure plate, can be built on deep water and even in space.</description>
    <texturePath>terrains/bridgefloor</texturePath>
    <isFoundation>true</isFoundation>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Walkable</li>
      <li MayRequire="ludeon.rimworld.odyssey">Substructure</li>
      <li MayRequire="vanillaexpanded.gravship2">VGE_SubstructureAndOrbitalPlatform</li>
    </affordances>
    <costList>
      <Steel>1</Steel>
    </costList>
    <statBases>
      <MarketValue>0</MarketValue>
      <WorkToBuild>400</WorkToBuild>
      <Beauty>2</Beauty>
      <Cleanliness>5</Cleanliness>
    </statBases>
    <tags>
      <li>FineFloor</li>
      <li>Substructure</li>
    </tags>
    <researchPrerequisites>
      <li>WNA_StandardArsenal</li>
    </researchPrerequisites>
    <designatorDropdown>WNA_FloorGroup_Platform</designatorDropdown>
  </TerrainDef>
  <TerrainDef ParentName="WNA_FloorsBase">
    <defName>WNA_PlatformCarpet</defName>
    <label>carpet platform</label>
    <description>Platform with soft surface, more suitable for interior decoration than concrete platforms.</description>
    <texturePath>terrains/bridgecarpet</texturePath>
    <isFoundation>true</isFoundation>
    <isPaintable>true</isPaintable>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Walkable</li>
      <li MayRequire="ludeon.rimworld.odyssey">Substructure</li>
      <li MayRequire="vanillaexpanded.gravship2">VGE_SubstructureAndOrbitalPlatform</li>
    </affordances>
    <costList>
      <Cloth>1</Cloth>
    </costList>
    <statBases>
      <MarketValue>0</MarketValue>
      <WorkToBuild>400</WorkToBuild>
      <Beauty>10</Beauty>
      <Cleanliness>4</Cleanliness>
    </statBases>
    <tags>
      <li>FineFloor</li>
      <li>Substructure</li>
    </tags>
    <researchPrerequisites>
      <li>WNA_StandardArsenal</li>
    </researchPrerequisites>
    <designatorDropdown>WNA_FloorGroup_Platform</designatorDropdown>
  </TerrainDef>
  <TerrainDef ParentName="WNA_FloorsBase">
    <defName>WNA_PlatformSoil</defName>
    <label>artificial soil platform</label>
    <description>Basic artificial soil, with special machines hiding beneath this soil can greatly boost plants' growth.</description>
    <texturePath>terrains/bridgesoil</texturePath>
    <isFoundation>true</isFoundation>
    <affordances Inherit="false">
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Walkable</li>
      <li>GrowSoil</li>
      <li MayRequire="sirmashedpotato.ashlands">Mashed_Ashlands_GrowAsh</li>
      <li MayRequire="dankpyon.medieval.overhaul">DankPyon_GrowSoilVine</li>
    </affordances>
    <statBases>
      <MarketValue>0</MarketValue>
      <WorkToBuild>400</WorkToBuild>
    </statBases>
    <costList>
      <WoodLog>1</WoodLog>
    </costList>
    <tags>
      <li>Substructure</li>
      <li>Soil</li>
      <li MayRequire="sirmashedpotato.ashlands">Mashed_Ashlands_Ash</li>
      <li>WNA_Sowable</li>
    </tags>
    <fertility>6</fertility>
    <researchPrerequisites>
      <li>WNA_StandardArsenal</li>
    </researchPrerequisites>
    <designatorDropdown>WNA_FloorGroup_Platform</designatorDropdown>
  </TerrainDef>

    <!-- Whelingnorthan -->
  <TerrainDef ParentName="WNA_FloorsBase" Name="WNA_PlatformGrouped">
    <defName>WNA_FocusPlatform</defName>
    <label>pale platform</label>
    <description>Colorless supporting platform</description>
    <texturePath>terrains/wna_floor</texturePath>
    <edgeType>Hard</edgeType>
    <isPaintable>true</isPaintable>
    <isFoundation>true</isFoundation>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Walkable</li>
      <li MayRequire="ludeon.rimworld.odyssey">Substructure</li>
      <li MayRequire="vanillaexpanded.gravship2">VGE_SubstructureAndOrbitalPlatform</li>
    </affordances>
    <statBases>
      <MarketValue>0</MarketValue>
      <CleaningTimeFactor>0.01</CleaningTimeFactor>
      <WorkToBuild>20</WorkToBuild>
      <Beauty>20</Beauty>
      <Cleanliness>20</Cleanliness>
      <ContainmentStrength MayRequire="Ludeon.Rimworld.Anomaly">1000000</ContainmentStrength>
    </statBases>
    <tags>
      <li>FineFloor</li>
      <li>Substructure</li>
    </tags>
    <researchPrerequisites>
      <li>WNA_WhelingnortherApocalypse</li>
    </researchPrerequisites>
    <designatorDropdown>WNA_FloorGroup_Platform_Focus</designatorDropdown>
  </TerrainDef>
  <TerrainDef ParentName="WNA_PlatformGrouped">
    <defName>WNA_FocusPlatformPlain</defName>
    <label>plain platform</label>
    <description>Plain supporting platform.</description>
    <texturePath>terrains/wna_plainplatform</texturePath>
    <isPaintable>false</isPaintable>
  </TerrainDef>
  <TerrainDef ParentName="WNA_PlatformGrouped">
    <defName>WNA_FocusPlatformDim</defName>
    <label>dim platform</label>
    <description>Dim supporting platform</description>
    <texturePath>terrains/wna_floor2</texturePath>
    <isPaintable>false</isPaintable>
  </TerrainDef>
  <TerrainDef ParentName="WNA_PlatformGrouped">
    <defName>WNA_FocusPlatformPatchwork</defName>
    <label>patchwork platform</label>
    <description>Patched supporting platform</description>
    <texturePath>terrains/wna_floor3</texturePath>
  </TerrainDef>
  <TerrainDef ParentName="WNA_PlatformGrouped">
    <defName>WNA_FocusPlatformTwistedVoid</defName>
    <label>twisted void platform</label>
    <description>Looks like some evil seal.</description>
    <texturePath>terrains/wna_floor4</texturePath>
    <isPaintable>false</isPaintable>
  </TerrainDef>
  <TerrainDef ParentName="WNA_PlatformGrouped">
    <defName>WNA_FocusPlatformMosaic</defName>
    <label>mosaic platform</label>
    <description>Fine mosaic floor.</description>
    <texturePath>terrains/wna_floor5</texturePath>
  </TerrainDef>
  <TerrainDef ParentName="WNA_PlatformGrouped">
    <defName>WNA_FocusPlatformCarve</defName>
    <label>carve platform</label>
    <description>Carved floor.</description>
    <texturePath>terrains/wna_floor6</texturePath>
  </TerrainDef>
  <TerrainDef ParentName="WNA_PlatformGrouped">
    <defName>WNA_FocusPlatformDarkCarve</defName>
    <label>dark carve platform</label>
    <description>Dark carved floor.</description>
    <texturePath>terrains/wna_floor7</texturePath>
    <isPaintable>false</isPaintable>
