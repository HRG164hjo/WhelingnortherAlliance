<Defs>
  <DamageDef ParentName="WNA_DamageBase">
    <defName>WNA_Culling</defName>
    <label>whelingnorther corrosion</label>
    <deathMessage>{0} has molten.</deathMessage>
    <hediff>MissingBodyPart</hediff>
    <impactSoundType>Slice</impactSoundType>
    <workerClass>WNA.WNADamageWorker.DmgWorker_Culling</workerClass>
    <causeStun>true</causeStun>
    <ignoreShields>true</ignoreShields>
    <cutExtraTargetsCurve>
      <points>
        <li>0,1</li>
        <li>0.3,2</li>
        <li>0.6,4</li>
        <li>1,8</li>
      </points>
    </cutExtraTargetsCurve>
    <cutCleaveBonus>1.4</cutCleaveBonus>
    <buildingDamageFactor>100000</buildingDamageFactor>
    <plantDamageFactor>100000</plantDamageFactor>
    <corpseDamageFactor>100000</corpseDamageFactor>
    <additionalHediffs>
      <li>
        <hediff>WNA_Corrosion</hediff>
        <severityPerDamageDealt>100000</severityPerDamageDealt>
      </li>
    </additionalHediffs>
  </DamageDef>
  <ToolCapacityDef>
    <defName>WNA_Culling</defName>
    <label>culling</label>
  </ToolCapacityDef>
  <ManeuverDef>
    <defName>WNA_Culling</defName>
    <requiredCapacity>WNA_Culling</requiredCapacity>
    <verb>
      <verbClass>Verb_MeleeAttackDamage</verbClass>
      <meleeDamageDef>WNA_Culling</meleeDamageDef>
    </verb>
    <logEntryDef>MeleeAttack</logEntryDef>
    <combatLogRulesHit>Maneuver_Slash_MeleeHit</combatLogRulesHit>
    <combatLogRulesDeflect>Maneuver_Slash_MeleeDeflect</combatLogRulesDeflect>
    <combatLogRulesMiss>Maneuver_Slash_MeleeMiss</combatLogRulesMiss>
    <combatLogRulesDodge>Maneuver_Slash_MeleeDodge</combatLogRulesDodge>
  </ManeuverDef>
  
