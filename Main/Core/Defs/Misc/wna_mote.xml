<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="MoteBase">
    <defName>WNA_Mote_HolyorderRead</defName>
    <label>holyorder reading effect</label>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0.1</fadeInTime>
      <solidTime>99999</solidTime>
      <fadeOutTime>0.1</fadeOutTime>
      <needsMaintenance>true</needsMaintenance>
    </mote>
    <graphicData>
      <texPath>apparel/wna_holyorder</texPath>
      <drawSize>0.44</drawSize>
    </graphicData>
  </ThingDef>
  
  <ThingDef ParentName="MoteBase">
    <defName>WNA_Mote_UpliftMarker</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0.15</fadeInTime>
      <solidTime>0.65</solidTime>
      <fadeOutTime>0.35</fadeOutTime>
    </mote>
    <graphicData>
      <texPath>Things/Mote/SoftRingWhite</texPath>
      <graphicClass>Graphic_Mote</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <color>(155,155,155,191)</color>
      <drawSize>(2.4, 2.4)</drawSize>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="MoteBase">
    <defName>WNA_Mote_MindControl</defName>
    <label>mind control effect</label>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0.2</fadeInTime>
      <solidTime>999999</solidTime>
      <fadeOutTime>0.2</fadeOutTime>
      <needsMaintenance>true</needsMaintenance>
    </mote>
    <graphicData>
      <texPath>Things/Mote/SoftRingWhite</texPath>
      <graphicClass>Graphic_Mote</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <color>(123,80,167,255)</color>
      <drawSize>(1.25, 1.25)</drawSize>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="MoteBase">
    <defName>WNA_Mote_MindControlPermanent</defName>
    <label>permanent mind control effect</label>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0.2</fadeInTime>
      <solidTime>999999</solidTime>
      <fadeOutTime>0.2</fadeOutTime>
      <needsMaintenance>true</needsMaintenance>
    </mote>
    <graphicData>
      <texPath>Things/Mote/SoftRingWhite</texPath>
