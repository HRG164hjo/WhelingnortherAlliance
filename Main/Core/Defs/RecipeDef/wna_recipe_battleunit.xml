<Defs>
  <RecipeDef ParentName="WNA_RecipeBase" Name="WNA_LightUnitRecipeBase" Abstract="true">
    <jobString>assembling a battle unit.</jobString>
    <workerClass>WNA.WNARecipeWorker.Recipe_ProduceUnit</workerClass>
    <workerCounterClass>WNA.WNARecipeWorker.RecipeWorkerCounter_ProduceUnit</workerCounterClass>
    <workAmount>2500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>90</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Hyperweave</li>
          </thingDefs>
        </filter>
        <count>75</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>7</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Plasteel</li>
        <li>Hyperweave</li>
        <li>ComponentIndustrial</li>
      </thingDefs>
    </fixedIngredientFilter>
    <recipeUsers>
      <li>FabricationBench</li>
    </recipeUsers>
    <researchPrerequisites>
      <li>WNA_AutomatedBattleDrone</li>
    </researchPrerequisites>
  </RecipeDef>
