<Defs>
  <RecipeDef Name="WNA_BodypartRecipe" ParentName="SurgeryFlesh" Abstract="True">
    <workerClass>Recipe_InstallArtificialBodyPart</workerClass>
    <workAmount>2500</workAmount>
    <surgeryOutcomeEffect IsNull="True"/>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <skillRequirements>
      <Medicine>8</Medicine>
    </skillRequirements>
    <recipeUsers>
      <li>Human</li>
      <li MayRequire="Ludeon.rimworld.Anomaly">CreepJoiner</li>
      <li>WNA_Humanoid</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Medicine</li>
      </categories>
      <thingDefs>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
  </RecipeDef>

