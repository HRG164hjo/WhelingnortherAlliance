<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <RecipeDef ParentName="WNA_RecipeBase">
    <defName>WNA_RiteDivision</defName>
    <description>divide a corpse so that it can be used for more uses.</description>
    <jobString>working.</jobString>
    <label>rite division</label>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Corpses</li>
						<li MayRequire="sarg.rimbees">RB_Combs</li>
          </categories>
          <thingDefs>
            <li MayRequire="sarg.rimbees">RB_WildHive_Temperate</li>
            <li MayRequire="sarg.rimbees">RB_WildHive_Mild</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li MayRequire="sarg.rimbees">RB_WildHive_Temperate</li>
        <li MayRequire="sarg.rimbees">RB_WildHive_Mild</li>
      </thingDefs>
      <categories>
        <li>Corpses</li>
        <li MayRequire="sarg.rimbees">RB_Combs</li>
      </categories>
    </fixedIngredientFilter>
    <specialProducts>
      <li>Butchery</li>
      <li>Smelted</li>
    </specialProducts>
    <workAmount>300</workAmount>
    <recipeUsers>
      <li>WNA_Ritespot</li>
    </recipeUsers>
  </RecipeDef>

  <RecipeDef ParentName="WNA_RecipeBase">
    <defName>WNA_RiteDemolition</defName>
    <description>break down a weapon or apparel and see if there's something can be recycled.</description>
    <jobString>working.</jobString>
    <label>rite demolition</label>
    <workerClass>WNA.WNARecipeWorker.Recipe_RiteDemolition</workerClass>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Weapons</li>
            <li>Apparel</li>
            <li>MortarShells</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Weapons</li>
        <li>Apparel</li>
        <li>MortarShells</li>
      </categories>
    </fixedIngredientFilter>
    <specialProducts>
      <li>Butchery</li>
      <li>Smelted</li>
    </specialProducts>
    <workAmount>300</workAmount>
    <recipeUsers>
      <li>WNA_Ritespot</li>
    </recipeUsers>
  </RecipeDef>

  <RecipeDef ParentName="WNA_RecipeBase">
    <defName>WNA_RiteAbleting</defName>
    <description>break down slag chunks to retrieve useful things, more productive than traditional methods.</description>
    <jobString>working.</jobString>
    <label>rite ableting</label>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Chunks</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Chunks</li>
      </categories>
    </fixedIngredientFilter>
    <specialProducts>
      <li>Butchery</li>
      <li>Smelted</li>
    </specialProducts>
    <workAmount>300</workAmount>
    <recipeUsers>
      <li>WNA_Ritespot</li>
    </recipeUsers>
  </RecipeDef>

</Defs>