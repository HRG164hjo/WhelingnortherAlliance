<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef Name="WNA_BodypartHediff" Abstract="True">
    <hediffClass>Hediff_AddedPart</hediffClass>
    <defaultLabelColor>(180, 189, 199)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>true</priceImpact>
    <countsAsAddedPartOrImplant>true</countsAsAddedPartOrImplant>
    <allowMothballIfLowPriorityWorldPawn>true</allowMothballIfLowPriorityWorldPawn>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
  </HediffDef>

  <!---->
  <HediffDef ParentName="WNA_BodypartHediff">
    <defName>WNA_Part_AdvBionicSkin</defName>
    <label>adv. bionic skin</label>
    <description>An installed adv bionic skin. \n\n&lt;color=#C86400&gt;Rad proof.&lt;/color&gt;</description>
    <hediffClass>HediffWithComps</hediffClass>
    <stages>
      <li>
        <partIgnoreMissingHP>true</partIgnoreMissingHP>
        <statOffsets>
          <VacuumResistance>0.8</VacuumResistance>
          <ComfyTemperatureMin>-300</ComfyTemperatureMin>
          <ComfyTemperatureMax>500</ComfyTemperatureMax>
          <PawnBeauty>1</PawnBeauty>
          <ArmorRating_Sharp>2</ArmorRating_Sharp>
          <ArmorRating_Blunt>2</ArmorRating_Blunt>
          <ArmorRating_Heat>2</ArmorRating_Heat>
          <ToxicEnvironmentResistance MayRequire="ludeon.rimworld.biotech">1</ToxicEnvironmentResistance>
          <VacuumResistance MayRequire="ludeon.rimworld.odyssey">1</VacuumResistance>
        </statOffsets>
        <statFactors>
          <Flammability>0</Flammability>
          <IncomingDamageFactor MayRequire="ludeon.rimworld.royalty">0</IncomingDamageFactor>
        </statFactors>
        <preventVacuumBurns>true</preventVacuumBurns>
      </li>
    </stages>
    <modExtensions>
      <li Class="WNA.WNAModExtension.TechnoConfig">
        <immuneToRadiation>true</immuneToRadiation>
      </li>
    </modExtensions>
  </HediffDef>
  
  <HediffDef ParentName="WNA_BodypartHediff">
    <defName>WNA_Part_AdvBionicSpine</defName>
    <label>adv. bionic spine</label>
    <description>An installed adv bionic spine.</description>
    <addedPartProps>
      <solid>true</solid>
      <partEfficiency>2.0</partEfficiency>
      <betterThanNatural>true</betterThanNatural>
    </addedPartProps>
    <stages>
      <li>
        <partIgnoreMissingHP>true</partIgnoreMissingHP>
        <statOffsets>
          <CarryingCapacity>60000</CarryingCapacity>
        </statOffsets>
        <statFactors>
          <RestFallRateFactor>0.5</RestFallRateFactor>
          <MeleeCooldownFactor>0.5</MeleeCooldownFactor>
          <MeleeDodgeChance>2</MeleeDodgeChance>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="WNA.WNAHediffComp.PropProximityBlink">
        <cooldown>32</cooldown>
        <counterBack>true</counterBack>
        <skipaway>7.9~15.9</skipaway>
        <damageDef>Crush</damageDef>
        <power>40</power>
      </li>
    </comps>
    <modExtensions>
      <li Class="WNA.WNAModExtension.MassCapacity">
        <massCapacity>60000</massCapacity>
      </li>
    </modExtensions>
  </HediffDef>
  
  <HediffDef ParentName="WNA_BodypartHediff">
    <defName>WNA_Part_AdvBionicStomach</defName>
    <label>adv. bionic stomach</label>
