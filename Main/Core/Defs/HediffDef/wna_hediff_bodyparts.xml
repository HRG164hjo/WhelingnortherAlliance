              </li>
              <li>
                <def>Flame</def>
                <amount>30</amount>
              </li>
            </extraMeleeDamages>
          </li>
          <li>
            <label>edge</label>
            <capacities>
              <li>Cut</li>
            </capacities>
            <power>40</power>
            <cooldownTime>1</cooldownTime>
            <armorPenetration>3</armorPenetration>
            <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
            <extraMeleeDamages>
              <li>
