    <addedPartProps>
      <solid>true</solid>
      <partEfficiency>2.0</partEfficiency>
      <betterThanNatural>true</betterThanNatural>
    </addedPartProps>
    <stages>
      <li>
        <partIgnoreMissingHP>true</partIgnoreMissingHP>
        <foodPoisoningChanceFactor>0</foodPoisoningChanceFactor>
        <hungerRateFactor>0.5</hungerRateFactor>
        <statFactors>
          <MaxNutrition>2</MaxNutrition>
        </statFactors>
        <capMods>
          <li>
            <capacity>Metabolism</capacity>
            <postFactor>1.5</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  
  <HediffDef ParentName="WNA_BodypartHediff">
