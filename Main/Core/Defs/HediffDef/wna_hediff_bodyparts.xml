  <HediffDef ParentName="WNA_BodypartHediff">
    <defName>WNA_Part_AdvBionicBrain</defName>
    <label>adv. bionic brain chip</label>
    <description>An installed adv bionic brain chip.</description>
    <hediffClass>Hediff_Implant</hediffClass>
    <stages>
      <li>
        <partIgnoreMissingHP>true</partIgnoreMissingHP>
        <partEfficiencyOffset>3</partEfficiencyOffset>
        <pctAllThoughtNullification>1</pctAllThoughtNullification>
        <overrideMoodBase>1</overrideMoodBase>
        <socialFightChanceFactor>0</socialFightChanceFactor>
        <blocksMentalBreaks>true</blocksMentalBreaks>
        <statFactors>
          <GlobalLearningFactor>1.5</GlobalLearningFactor>
          <ResearchSpeed>3</ResearchSpeed>
          <StudyEfficiency MayRequire="Ludeon.rimworld.Anomaly">1.5</StudyEfficiency>
          <EntityStudyRate MayRequire="Ludeon.rimworld.Anomaly">3</EntityStudyRate>
          <Ability_PsyfocusCost>0</Ability_PsyfocusCost>
          <Ability_EntropyGain>0</Ability_EntropyGain>
          <Ability_CastingTime>0.5</Ability_CastingTime>
        </statFactors>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>1.5</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  
