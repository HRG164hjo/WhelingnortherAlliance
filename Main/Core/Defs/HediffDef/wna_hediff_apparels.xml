<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>WNA_StdSuitBoost</defName>
    <label>suit boost</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>Special designs and techniques in military suit is helping this pawn performing better than normal.</description>
    <defaultLabelColor>(0,0,0)</defaultLabelColor>
    <everCurableByItem>false</everCurableByItem>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped"/>
    </comps>
    <stages>
      <li>
        <socialFightChanceFactor>0</socialFightChanceFactor>
        <blocksMentalBreaks>true</blocksMentalBreaks>
        <blocksInspirations>true</blocksInspirations>
        <preventVacuumBurns>true</preventVacuumBurns>
        <statFactors>
          <FilthRate>0</FilthRate>
          <Flammability>0</Flammability>
          <PawnTrapSpringChance>0</PawnTrapSpringChance>
          <CarryingCapacity>2000</CarryingCapacity>
        </statFactors>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>1.75</postFactor>
          </li>
          <li>
            <capacity>Moving</capacity>
            <postFactor>1.75</postFactor>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <postFactor>1.75</postFactor>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <postFactor>1.67</postFactor>
          </li>
          <li>
            <capacity>BloodFiltration</capacity>
            <postFactor>1.67</postFactor>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <postFactor>1.67</postFactor>
          </li>
          <li>
            <capacity>Metabolism</capacity>
            <postFactor>1.67</postFactor>
          </li>
          <li>
            <capacity>Eating</capacity>
            <postFactor>1.50</postFactor>
          </li>
          <li>
            <capacity>Talking</capacity>
            <postFactor>1.50</postFactor>
          </li>
          <li>
            <capacity>Sight</capacity>
            <postFactor>1.50</postFactor>
          </li>
          <li>
            <capacity>Hearing</capacity>
            <postFactor>1.50</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
    <modExtensions>
      <li Class="WNA.WNAModExtension.TechnoConfig">
        <canFreePass>true</canFreePass>
      </li>
    </modExtensions>
  </HediffDef>

  <HediffDef>
    <defName>WNA_IllusionCore</defName>
    <label>illusion core</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>This pawn is covered by a stealth field.</description>
    <defaultLabelColor>(0,0,0)</defaultLabelColor>
    <everCurableByItem>false</everCurableByItem>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped"/>
      <li Class="HediffCompProperties_Invisibility">
        <visibleToPlayer>false</visibleToPlayer>
        <affectedByDisruptor>false</affectedByDisruptor>
      </li>
    </comps>
    <stages/>
  </HediffDef>

  <HediffDef>
    <defName>WNA_DeadzoneBelt</defName>
    <label>irradiating</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>This pawn is emitting deadly radiation field.</description>
    <defaultLabelColor>(0,0,0)</defaultLabelColor>
    <everCurableByItem>false</everCurableByItem>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped"/>
      <li Class="WNA.WNAHediffComp.PropRadFieldSpreader">
        <config>
          <radLevel>2000</radLevel>
          <radius>9.9</radius>
          <edgeFactor>0.25</edgeFactor>
          <threshold>0</threshold>
          <radLevelDelay>27</radLevelDelay>
        </config>
      </li>
    </comps>
    <stages/>
  </HediffDef>

  <HediffDef>
    <defName>WNA_ChronoPack</defName>
    <label>phase pack</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>An equipped phase pack allows this pawn to do unbelieveable movements.</description>
    <defaultLabelColor>(0,0,0)</defaultLabelColor>
    <everCurableByItem>false</everCurableByItem>
    <isBad>false</isBad>
    <comps>
      <li Class="WNA.WNAHediffComp.PropTeleporterHediff">
        <minDistanceToBlink>3</minDistanceToBlink>
        <maxDistanceToBlink>500</maxDistanceToBlink>
        <blinkIntervalTicks>180</blinkIntervalTicks>
        <warpStunEffect>48</warpStunEffect>
      </li>
    </comps>
    <stages/>
  </HediffDef>

</Defs>
