<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>WNA_Inhuman</defName>
    <label>inhuman</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>This thing may used to be a human, and may still looks like a human, but from inside it has been gone far from human being.</description>
    <defaultLabelColor>(0,0,0)</defaultLabelColor>
    <makesAlert>false</makesAlert>
    <everCurableByItem>false</everCurableByItem>
    <duplicationAllowed>false</duplicationAllowed>
    <isBad>false</isBad>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <preventsPregnancy>true</preventsPregnancy>
    <preventsLungRot>true</preventsLungRot>
    <preventsDeath>true</preventsDeath>
    <allowMothballIfLowPriorityWorldPawn>true</allowMothballIfLowPriorityWorldPawn>
    <allowedMeditationFocusTypes>
      <li>Void</li>
    </allowedMeditationFocusTypes>
    <aptitudes>
      <Shooting>9999</Shooting>
      <Melee>9999</Melee>
      <Construction>9999</Construction>
      <Mining>9999</Mining>
      <Cooking>9999</Cooking>
      <Plants>9999</Plants>
      <Animals>9999</Animals>
      <Crafting>9999</Crafting>
      <Artistic>9999</Artistic>
      <Medicine>9999</Medicine>
      <Social>9999</Social>
      <Intellectual>9999</Intellectual>
    </aptitudes>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
        <painFactor>0</painFactor>
        <totalBleedFactor>0</totalBleedFactor>
        <opinionOfOthersFactor>0</opinionOfOthersFactor>
        <socialFightChanceFactor>0</socialFightChanceFactor>
        <foodPoisoningChanceFactor>0</foodPoisoningChanceFactor>
        <forgetMemoryThoughtMtbDays>0.01</forgetMemoryThoughtMtbDays>
        <severityGainFactor>0</severityGainFactor>
        <blocksMentalBreaks>true</blocksMentalBreaks>
        <blocksInspirations>true</blocksInspirations>
        <pctAllThoughtNullification>1</pctAllThoughtNullification>
        <overrideMoodBase>1</overrideMoodBase>
        <preventVacuumBurns>true</preventVacuumBurns>
      </li>
    </stages>
    <comps>
      <li Class="WNA.WNAHediffComp.PropPostRemoveHediff">
        <hediff>WNA_Inhuman</hediff>
      </li>
      <li Class="WNA.WNAHediffComp.PropProximityBlink">
        <cooldown>1</cooldown>
        <counterBack>true</counterBack>
        <damageDef>WNA_Culling</damageDef>
      </li>
    </comps>
    <modExtensions>
      <li Class="WNA.WNAModExtension.TechnoConfig">
        <canFreePass>true</canFreePass>
      </li>
    </modExtensions>
  </HediffDef>

  <HediffDef>
    <defName>WNA_PermaconstHidden</defName>
    <label>permaconst seen</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>Permaconst Command has seen you.</description>
    <defaultLabelColor>(0,0,0)</defaultLabelColor>
    <everCurableByItem>false</everCurableByItem>
    <duplicationAllowed>false</duplicationAllowed>
    <isBad>false</isBad>
    <keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
    <comps>
      <li Class="WNA.WNAHediffComp.PropPostRemoveHediff">
        <hediff>WNA_PermaconstActive</hediff>
      </li>
      <li Class="WNA.WNAHediffComp.PropPermaconstHidden"/>
    </comps>
  </HediffDef>
  <HediffDef>
    <defName>WNA_PermaconstActive</defName>
    <label>permaconst taken-over</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>This creature is enthralled by Permaconst Command, and now a part of an uncontrolled defense system.</description>
    <defaultLabelColor>(0,0,0)</defaultLabelColor>
    <everCurableByItem>false</everCurableByItem>
    <duplicationAllowed>false</duplicationAllowed>
    <isBad>false</isBad>
    <keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
    <blocksSocialInteraction>true</blocksSocialInteraction>
    <blocksSleeping>true</blocksSleeping>
    <stages>
      <li>
        <socialFightChanceFactor>0</socialFightChanceFactor>
        <blocksMentalBreaks>true</blocksMentalBreaks>
        <blocksInspirations>true</blocksInspirations>
        <preventVacuumBurns>true</preventVacuumBurns>
        <overrideMoodBase>-1</overrideMoodBase>
        <pctAllThoughtNullification>1</pctAllThoughtNullification>
        <forgetMemoryThoughtMtbDays>2.357</forgetMemoryThoughtMtbDays>
        <disablesNeeds>
          <li>Beauty</li>
          <li>Comfort</li>
          <li>Outdoors</li>
          <li>Indoors</li>
          <li>DrugDesire</li>
          <li>RoomSize</li>
          <li>Rest</li>
          <li>Food</li>
          <li>Joy</li>
          <li MayRequire="telardo.romanceontherim">RomanceOnTheRim_Need_Romance</li>
          <li MayRequire="rim.job.world">Sex</li>
        </disablesNeeds>
        <statFactors>
          <Flammability>0</Flammability>
          <AimingDelayFactor>0</AimingDelayFactor>
          <RangedCooldownFactor>0.5</RangedCooldownFactor>
          <MoveSpeed>2</MoveSpeed>
          <CrawlSpeed>5</CrawlSpeed>
          <MeleeCooldownFactor>0.1</MeleeCooldownFactor>
          <MeleeDodgeChance>10</MeleeDodgeChance>
          <BandwidthCost>9999</BandwidthCost>
          <PsychicSensitivity>0</PsychicSensitivity>
          <StaggerDurationFactor>0</StaggerDurationFactor>
          <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">10</ToxicEnvironmentResistance>
          <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">10</VacuumResistance>
        </statFactors>
        <statOffsets>
          <ComfyTemperatureMin>-2000</ComfyTemperatureMin>
          <ComfyTemperatureMax>2000</ComfyTemperatureMax>
          <EMPResistance>100</EMPResistance>
          <MeleeDodgeChance>1</MeleeDodgeChance>
          <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">1</ToxicEnvironmentResistance>
          <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">1</VacuumResistance>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="WNA.WNAHediffComp.PropPostRemoveHediff">
        <hediff>WNA_PermaconstActive</hediff>
      </li>
      <li Class="WNA.WNAHediffComp.PropPermaconstActive"/>
    </comps>
    <modExtensions>
      <li Class="PathfindingFramework.MovementExtension" MayRequire="pathfinding.framework">
        <movementDef>WNA_Movement</movementDef>
      </li>
      <li Class="WNA.WNAModExtension.TechnoConfig">
        <immuneToRadiation>true</immuneToRadiation>
        <canFreePass>true</canFreePass>
      </li>
    </modExtensions>
  </HediffDef>
</Defs>
