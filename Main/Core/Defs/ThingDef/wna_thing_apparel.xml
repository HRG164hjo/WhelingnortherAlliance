<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Generic -->
  <ThingDef ParentName="WNA_ApparelBase">
    <defName>WNA_StdMiliSuit</defName>
    <label>standard military suit</label>
    <description>Standard on-skin suit for Whelingnorther Alliance, has effective protection against various types of harms.</description>
    <graphicData>
      <texPath>apparel/stdmilisuit/icon_stdmilisuit</texPath>
      <color>(180,189,199)</color>
    </graphicData>
    <costList>
      <Steel>25</Steel>
      <Hyperweave>60</Hyperweave>
    </costList>
    <statBases>
      <MarketValue>1000</MarketValue>
      <ArmorRating_Sharp>2.73</ArmorRating_Sharp>
      <ArmorRating_Blunt>2.00</ArmorRating_Blunt>
      <ArmorRating_Heat>3.37</ArmorRating_Heat>
      <Insulation_Cold>60</Insulation_Cold>
      <Insulation_Heat>100</Insulation_Heat>
    </statBases>
    <equippedStatOffsets>
      <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">1</VacuumResistance>
      <PainShockThreshold>1</PainShockThreshold>
      <ToxicResistance>1</ToxicResistance>
      <ActivitySuppressionRate MayRequire="ludeon.rimworld.anomaly">1</ActivitySuppressionRate>
    </equippedStatOffsets>
    <apparel>
      <defaultOutfitTags>
        <li>Soldier</li>
        <li>Spacefarer</li>
      </defaultOutfitTags>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
        <li>Hands</li>
        <li>Feet</li>
      </bodyPartGroups>
      <wornGraphicPath>apparel/stdmilisuit/stdmilisuit</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
    </apparel>
    <recipeMaker>
      <researchPrerequisites>
        <li>WNA_MilitarySupply</li>
      </researchPrerequisites>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
      <defaultIngredientFilter>
        <categories>
          <li>Root</li>
        </categories>
      </defaultIngredientFilter>
    </recipeMaker>
    <comps>
      <li Class="WNA.WNAThingComp.PropApparelEquipHediff">
        <hediff>WNA_StdSuitBoost</hediff>
      </li>
      <li Class="WNA.WNAThingComp.PropBodyshapeOverride"/>
    </comps>
    <modExtensions>
      <li Class="WNA.WNAModExtension.MassCapacity">
        <massCapacity>60000</massCapacity>
      </li>
      <li Class="WNA.WNAModExtension.TechnoConfig">
        <immuneToRadiation>true</immuneToRadiation>
      </li>
      <li MayRequire="oskarpotocki.vanillafactionsexpanded.core" Class="VEF.Apparels.ApparelExtension">
        <preventBleeding>true</preventBleeding>
        <pawnCapacityMinLevels>
          <li>
            <capacity>Consciousness</capacity>
            <minLevel>1</minLevel>
          </li>
          <li>
            <capacity>Moving</capacity>
            <minLevel>1</minLevel>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <minLevel>1</minLevel>
          </li>
          <li>
            <capacity>Sight</capacity>
            <minLevel>1</minLevel>
          </li>
          <li>
            <capacity>Hearing</capacity>
            <minLevel>1</minLevel>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <minLevel>1</minLevel>
          </li>
          <li>
            <capacity>BloodFiltration</capacity>
            <minLevel>1</minLevel>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <minLevel>1</minLevel>
          </li>
          <li>
            <capacity>Metabolism</capacity>
            <minLevel>1</minLevel>
          </li>
        </pawnCapacityMinLevels>
      </li>
    </modExtensions>
  </ThingDef>

