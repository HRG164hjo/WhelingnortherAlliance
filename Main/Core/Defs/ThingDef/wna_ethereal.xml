<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="SkyfallerBase">
    <defName>WNA_WARPIN</defName>
    <label>drop pod (incoming)</label>
    <thingClass>DropPodIncoming</thingClass>
    <graphicData>
      <texPath>Things/Special/DropPodMechanoid</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>1.9</drawSize>
    </graphicData>
    <skyfaller>
      <angleCurve>
        <points>
          <li>(0,0)</li>
          <li>(1,0)</li>
        </points>
      </angleCurve>
      <ticksToImpactRange>1</ticksToImpactRange>
      <explosionRadius>9.9</explosionRadius>
      <explosionDamage>WNA_ChimingBlaze</explosionDamage>
      <explosionDamageFactor>1</explosionDamageFactor>
      <shadowSize>1</shadowSize>
      <anticipationSound />
      <anticipationSoundTicks>0</anticipationSoundTicks>
      <impactSound>DropPod_Impact</impactSound>
      <motesPerCell>0</motesPerCell>
      <speed>500</speed>
    </skyfaller>
    <modExtensions>
      <li Class="WNA.WNAModExtension.TechnoConfig">
        <ignoreRoof>true</ignoreRoof>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef>
    <defName>WNA_WARPON</defName>
    <label>drop pod</label>
    <category>Item</category>
    <drawerType>MapMeshAndRealTime</drawerType>
    <thingClass>WNA.WNAMiscs.WarpOn</thingClass>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <tickerType>Normal</tickerType>
    <soundOpen/>
    <graphicData>
      <texPath>Things/Special/DropPodMechanoid</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.9</drawSize>
      <shadowData>
        <volume>(0.8, 0.6, 0.8)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <blockWind>false</blockWind>
    <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
  </ThingDef>
  
  <ThingDef ParentName="WNA_EtherealThingBase">
    <defName>WNA_Ether_Aeroblaze</defName>
    <label>aeroblaze</label>
    <size>(1,1)</size>
    <thingClass>Skyfaller</thingClass>
    <drawerType>RealtimeOnly</drawerType>
    <graphicData>
      <texPath>projectiles/wna_aeroblaze</texPath>
      <shaderType>Transparent</shaderType>
      <drawSize>(1.6,6.4)</drawSize>
    </graphicData>
    <skyfaller>
      <shadowSize>(1.5,1.5)</shadowSize>
      <explosionRadius>27.9</explosionRadius>
      <explosionDamage>WNA_ChimingBlaze</explosionDamage>
      <rotateGraphicTowardsDirection>true</rotateGraphicTowardsDirection>
      <speed>24</speed>
      <angleCurve>
        <points>
          <li>(0,0)</li>
          <li>(1,0)</li>
        </points>
      </angleCurve>
    </skyfaller>
    <modExtensions>
      <li Class="WNA.WNAModExtension.TechnoConfig">
        <ignoreRoof>true</ignoreRoof>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="EtherealThingBase">
    <defName>WNA_StrikeFlash</defName>
    <label>strike flash</label>
    <thingClass>ThingWithComps</thingClass>
    <comps>
      <li Class="CompProperties_AffectsSky">
        <glow>1</glow>
        <skyColors>
          <sky>(255, 252, 246)</sky>
          <shadow>(150, 142, 130)</shadow>
          <overlay>(255, 250, 235)</overlay>
          <saturation>0.62</saturation>
        </skyColors>
      </li>
    </comps>
  </ThingDef>

  <!---->
  <ThingDef ParentName="EtherealThingBase">
    <defName>WNA_NukeAfterglow</defName>
    <label>nuke afterglow</label>
    <thingClass>ThingWithComps</thingClass>
    <comps>
      <li Class="CompProperties_AffectsSky">
        <glow>1</glow>
        <skyColors>
          <sky>(255, 198, 140)</sky>
          <shadow>(120, 74, 48)</shadow>
          <overlay>(255, 150, 82)</overlay>
          <saturation>0.78</saturation>
        </skyColors>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="WNA_EtherealThingBase">
    <defName>WNA_NukePayload</defName>
    <label>nuke payload</label>
    <thingClass>Skyfaller</thingClass>
    <drawerType>RealtimeOnly</drawerType>
    <selectable>false</selectable>
    <graphicData>
      <texPath>projectiles/wna_aeroblaze</texPath>
      <shaderType>Transparent</shaderType>
      <drawSize>(3.2,12.8)</drawSize>
    </graphicData>
    <skyfaller>
      <movementType>ConstantSpeed</movementType>
      <speed>4</speed>
      <ticksToImpactRange>50</ticksToImpactRange>
      <hitRoof>false</hitRoof>
      <shadowSize>(2.4,2.4)</shadowSize>
      <motesPerCell>0</motesPerCell>
      <rotateGraphicTowardsDirection>false</rotateGraphicTowardsDirection>
      <explosionRadius>500</explosionRadius>
      <explosionDamage>WNA_ChimingBlaze</explosionDamage>
      <angleCurve>
        <points>
          <li>(0,0)</li>
          <li>(1,0)</li>
        </points>
      </angleCurve>
    </skyfaller>
    <comps>
      <li Class="WNA.WNAThingComp.PropRadFieldBurst">
        <config>
          <radField>WNA_RadField_Radiation</radField>
          <radLevel>500</radLevel>
          <radius>500</radius>
        </config>
      </li>
    </comps>
    <modExtensions>
      <li Class="WNA.WNAModExtension.TechnoConfig">
        <ignoreRoof>true</ignoreRoof>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>