  </ThingDef>
  <ThingDef ParentName="WNA_BattleUnitBase">
    <defName>WNA_DemolinUnit</defName>
    <label>demolin unit</label>
    <description>A disposable charge carrier. Once it closes with an enemy it lights its fuse and detonates.</description>
    <statBases>
      <ArmorRating_Blunt>1</ArmorRating_Blunt>
      <ArmorRating_Heat>1</ArmorRating_Heat>
      <ArmorRating_Sharp>1</ArmorRating_Sharp>
      <MoveSpeed>19.9</MoveSpeed>
      <MaxFlightTime>60000</MaxFlightTime>
      <FlightCooldown>0</FlightCooldown>
    </statBases>
    <race>
      <baseBodySize>1.0</baseBodySize>
      <baseHealthScale>22.5</baseHealthScale>
      <canFlyInVacuum>true</canFlyInVacuum>
      <flightStartChanceOnJobStart>1</flightStartChanceOnJobStart>
      <canFlyIntoMap>false</canFlyIntoMap>
      <canLeaveMapFlying>false</canLeaveMapFlying>
    </race>
    <comps>
      <li Class="WNA.WNAThingComp.PropBattleUnitDetonator">
        <triggerRadius>3.9</triggerRadius>
        <checkIntervalTicks>23</checkIntervalTicks>
        <useEnemyTarget>true</useEnemyTarget>
        <ignoreFactionAllies>true</ignoreFactionAllies>
      </li>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>11.9</explosiveRadius>
        <explosiveDamageType>Thump</explosiveDamageType>
        <damageAmountBase>640</damageAmountBase>
        <armorPenetrationBase>2</armorPenetrationBase>
        <wickTicks>3~7</wickTicks>
        <explodeOnKilled>true</explodeOnKilled>
        <destroyThingOnExplosionSize>0</destroyThingOnExplosionSize>
      </li>
    </comps>
    <modExtensions>
      <li Class="WNA.WNAModExtension.TechnoConfig">
        <immuneToRadiation>true</immuneToRadiation>
        <immuneToMindControl>true</immuneToMindControl>
        <canFreePass>true</canFreePass>
      </li>
    </modExtensions>
  </ThingDef>

