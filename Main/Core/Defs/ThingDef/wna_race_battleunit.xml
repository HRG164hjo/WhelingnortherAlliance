<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <RulePackDef>
    <defName>WNA_NamerUnit</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name(p=3)->[codeName] [codeName]</li>
        <li>r_name->[codeName] [codeName]</li>
        <li>codeName->[pre]-[pos]</li>
        <li>pre(p=3)->[code][code][code]</li>
        <li>pre->[code][code][code][code]</li>
        <li>pos(p=3)->[code][code][code]</li>
        <li>pos->[code][code][code][code]</li>
        <li>code->[Digit]</li>
        <li>code->[Letter]</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <!---->
  <ThingDef ParentName="BasePawn" Name="WNA_BattleUnitBase" Abstract="true">
    <thingClass>WNA.WNAThingClass.ThingClass_BattleUnit</thingClass>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <statBases>
      <MarketValue>500</MarketValue>
      <CarryingCapacity>0</CarryingCapacity>
      <ComfyTemperatureMin>-1000</ComfyTemperatureMin>
      <ComfyTemperatureMax>2000</ComfyTemperatureMax>
      <FilthRate>0</FilthRate>
      <Flammability>0</Flammability>
      <Mass>75</Mass>
      <MentalBreakThreshold>0</MentalBreakThreshold>
      <PainShockThreshold>100</PainShockThreshold>
      <PsychicSensitivity>0</PsychicSensitivity>
      <StaggerDurationFactor>0</StaggerDurationFactor>
      <ToxicResistance>1</ToxicResistance>
      <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">1</ToxicEnvironmentResistance>
      <BandwidthCost MayRequire="Ludeon.RimWorld.Biotech">0</BandwidthCost>
    </statBases>
    <tools>
      <li>
        <label>arm</label>
        <labelNoLocation>arm</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>20</power>
        <cooldownTime>1</cooldownTime>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
      </li>
    </tools>
    <race>
      <fleshType>Mechanoid</fleshType>
      <body>WNA_UnitBody</body>
      <intelligence>ToolUser</intelligence>
      <thinkTreeMain>WNA_BattleUnitThinkTree</thinkTreeMain>
      <renderTree>Misc</renderTree>
      <alwaysAwake>true</alwaysAwake>
      <hasGenders>false</hasGenders>
      <hasCorpse>false</hasCorpse>
      <hasMeat>false</hasMeat>
      <foodType>None</foodType>
      <needsRest>false</needsRest>
      <baseHungerRate>0</baseHungerRate>
      <bloodDef>Filth_MachineBits</bloodDef>
      <lifeExpectancy>10000</lifeExpectancy>
      <canBecomeShambler>false</canBecomeShambler>
      <hasUnnaturalCorpse>false</hasUnnaturalCorpse>
      <nameGenerator MayRequire="Ludeon.RimWorld.Biotech">WNA_NamerUnit</nameGenerator>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Scyther_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Scyther_Death</soundDeath>
          <soundCall>Pawn_Mech_Scyther_Call</soundCall>
        </li>
      </lifeStageAges>
      <mechWeightClass MayRequire="Ludeon.RimWorld.Biotech">Medium</mechWeightClass>
    </race>
    <butcherProducts>
      <Steel>15</Steel>
    </butcherProducts>
    <comps>
      <li Class="WNA.WNAThingComp.PropDamageLimit">
        <damageLimit>500</damageLimit>
        <canAbsorb>true</canAbsorb>
      </li>
      <li Class="WNA.WNAThingComp.PropThingSelfHeal">
        <ticksPerHeal>100</ticksPerHeal>
        <healPercent>5</healPercent>
      </li>
      <li Class="WNA.WNAThingComp.PropBattleUnitRepairable" />
      <li Class="WNA.WNAThingComp.PropBattleUnitControl" />
      <li Class="WNA.WNAThingComp.PropSensorArray">
        <sensorSight>19.9</sensorSight>
        <checkInterval>30</checkInterval>
        <stunTicks>720</stunTicks>
      </li>
    </comps>
    <modExtensions>
      <li Class="WNA.WNAModExtension.KillDownUtility">
        <minCapacities>
          <Consciousness>1</Consciousness>
          <Moving>1</Moving>
          <Manipulation>1</Manipulation>
        </minCapacities>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="WNA_BattleUnitBase">
    <defName>WNA_BasicBattleUnit</defName>
    <label>basic battle unit</label>
    <description>A compact combat chassis built to hold a single integrated weapon.</description>
    <statBases>
      <MoveSpeed>6.0</MoveSpeed>
      <ArmorRating_Blunt>1</ArmorRating_Blunt>
      <ArmorRating_Heat>1</ArmorRating_Heat>
      <ArmorRating_Sharp>1</ArmorRating_Sharp>
    </statBases>
    <race>
      <baseBodySize>1.0</baseBodySize>
      <baseHealthScale>50</baseHealthScale>
    </race>
    <comps Inherit="false">
      <li Class="WNA.WNAThingComp.PropBattleUnitRepairable" />
      <li Class="WNA.WNAThingComp.PropBattleUnitControl" />
      <li Class="WNA.WNAThingComp.PropUnitWeapon">
        <weapons>
          <li>
            <thingDef>Gun_ChargeLance</thingDef>
            <weight>1</weight>
          </li>
          <li>
            <thingDef>Gun_ChargeRifle</thingDef>
            <weight>1</weight>
          </li>
        </weapons>
      </li>
    </comps>
    <modExtensions Inherit="false">
      <li Class="WNA.WNAModExtension.TechnoConfig">
        <canFreePass>true</canFreePass>
      </li>
      <li Class="WNA.WNAModExtension.KillDownUtility">
        <minCapacities>
          <Consciousness>0.6</Consciousness>
          <Moving>0.4</Moving>
          <Manipulation>0.5</Manipulation>
        </minCapacities>
      </li>
    </modExtensions>
  </ThingDef>

