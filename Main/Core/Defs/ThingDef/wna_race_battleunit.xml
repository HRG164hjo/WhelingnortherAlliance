  <ThingDef ParentName="WNA_BattleUnitBase">
    <defName>WNA_DemolinCarrierUnit</defName>
    <label>demolin carrier unnit</label>
    <description>A battle chassis rebuilt around a support core. It keeps its distance from the enemy, hurls energy bolts, and deploys disposable bomb buggies.</description>
    <statBases>
      <MoveSpeed>7.2</MoveSpeed>
      <ArmorRating_Blunt>6.00</ArmorRating_Blunt>
      <ArmorRating_Heat>6.00</ArmorRating_Heat>
      <ArmorRating_Sharp>6.00</ArmorRating_Sharp>
    </statBases>
    <race>
      <baseBodySize>1.0</baseBodySize>
      <baseHealthScale>1000</baseHealthScale>
      <thinkTreeMain>WNA_CasterThinkTree</thinkTreeMain>
    </race>
    <comps>
      <li Class="WNA.WNAThingComp.PropUnitWeapon">
        <weapons>
          <li>
            <thingDef>WNA_UnitChargeGun</thingDef>
            <weight>1</weight>
          </li>
        </weapons>
      </li>
    </comps>
    <modExtensions>
