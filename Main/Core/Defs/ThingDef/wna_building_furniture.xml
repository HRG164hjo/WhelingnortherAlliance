<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- civ -->
  <ThingDef ParentName="WNA_FurnitureBase">
    <defName>WNA_LifeSupporter</defName>
    <label>life suporter</label>
    <description>A wall-mounted life support unit, can provide light and stable temperature, also can provide oxygen in space.</description>
    <uiIconPath>buildings/wna_lifesupporter/icon</uiIconPath>
    <graphicData>
      <texPath>buildings/wna_lifesupporter/wna_lifesupporter</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawOffsetNorth>(0,0,0.9)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,-0.9)</drawOffsetSouth>
      <drawOffsetWest>(-0.9,0,0)</drawOffsetWest>
      <drawOffsetEast>(0.9,0,0)</drawOffsetEast>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <statBases>
      <Mass>0.5</Mass>
      <WorkToBuild>1500</WorkToBuild>
    </statBases>
    <costList/>
    <researchPrerequisites>
      <li>WNA_CivilianTech</li>
    </researchPrerequisites>
    <rotatable>true</rotatable>
    <tickerType>Rare</tickerType>
    <passability>Standable</passability>
    <building>
      <isEdifice>false</isEdifice>
      <isAttachment>true</isAttachment>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <placeWorkers>
      <li>Placeworker_AttachedToWall</li>
    </placeWorkers>
    <comps>
      <li Class="WNA.WNAThingComp.PropTempControl">
        <defaultTargetTemperature>20</defaultTargetTemperature>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>15</glowRadius>
        <overlightRadius>15</overlightRadius>
        <glowColor>(127,127,127,0)</glowColor>
        <colorPickerEnabled>true</colorPickerEnabled>
        <darklightToggle>true</darklightToggle>
      </li>
      <li Class="CompProperties_OxygenPusher" MayRequire="ludeon.rimworld.odyssey">
        <requiresPower>false</requiresPower>
        <airPerSecondPerHundredCells>1</airPerSecondPerHundredCells>
      </li>
    </comps>
  </ThingDef>
  
  <ThingDef ParentName="WNA_FurnitureBase">
    <defName>WNA_WallSafe</defName>
    <label>wall safe</label>
    <description>A wall-mounted storage unit.</description>
    <uiIconPath>buildings/wna_wallsafe/icon</uiIconPath>
    <graphicData>
      <texPath>buildings/wna_wallsafe/wna_wallsafe</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawOffsetNorth>(0,0,0.9)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,-0.9)</drawOffsetSouth>
      <drawOffsetWest>(-0.9,0,0)</drawOffsetWest>
      <drawOffsetEast>(0.9,0,0)</drawOffsetEast>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <statBases>
      <Mass>0.5</Mass>
      <WorkToBuild>1500</WorkToBuild>
    </statBases>
    <costList/>
    <researchPrerequisites>
      <li>WNA_CivilianTech</li>
    </researchPrerequisites>
    <rotatable>true</rotatable>
    <tickerType>Rare</tickerType>
    <passability>Standable</passability>
    <building>
      <isEdifice>false</isEdifice>
      <isAttachment>true</isAttachment>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <placeWorkers>
      <li>Placeworker_AttachedToWall</li>
    </placeWorkers>
    <inspectorTabs>
      <li>WNA.WNAThingComp.ITab_StorageCargoContents</li>
    </inspectorTabs>
    <comps>
      <li Class="WNA.WNAThingComp.PropStorageCargo">
        <storageCapacity>150000</storageCapacity>
        <useCountInsteadMass>false</useCountInsteadMass>
        <allowPawns>false</allowPawns>
        <countForWealth>false</countForWealth>
        <dropStorageOn>Demolish</dropStorageOn>
      </li>
    </comps>
  </ThingDef>
  
</Defs>