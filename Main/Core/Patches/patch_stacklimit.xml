<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[smallVolume="true" and stackLimit>1]/stackLimit</xpath>
    <value>
      <stackLimit>1000000</stackLimit>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[not(smallVolume="true") and stackLimit>1]/stackLimit</xpath>
    <value>
      <stackLimit>1000000</stackLimit>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[@Name="ChunkBase"]/stackLimit</xpath>
    <value>
      <stackLimit>100000</stackLimit>
      <drawGUIOverlay>true</drawGUIOverlay>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[@Name="ChunkBase"]/passability</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[@Name="ChunkBase"]/saveCompressible</xpath>
  </Operation>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Alpha Biomes</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[@Name="GU_ChunkBase"]/stackLimit</xpath>
          <value>
            <stackLimit>100000</stackLimit>
            <drawGUIOverlay>true</drawGUIOverlay>
          </value>
        </li>
        <li Class="PatchOperationRemove">
          <xpath>Defs/ThingDef[@Name="GU_ChunkBase"]/passability</xpath>
        </li>
        <li Class="PatchOperationRemove">
          <xpath>Defs/ThingDef[@Name="GU_ChunkBase"]/saveCompressible</xpath>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>