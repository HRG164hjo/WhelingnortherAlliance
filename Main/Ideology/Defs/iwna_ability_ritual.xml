<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <PreceptDef>
    <defName>WNA_AbilityGrant</defName>
    <label>transcendental communion</label>
    <description>A guided communion at an altar or ritual spot. During the rite, a single willing colonist opens their mind and is granted a new ability.</description>
    <issue>Ritual</issue>
    <preceptClass>RimWorld.Precept_Ritual</preceptClass>
    <ritualPatternBase>WNA_AbilityGrant</ritualPatternBase>
    <iconPath>UI/Icons/Rituals/RoleChange</iconPath>
    <visible>false</visible>
    <mergeRitualGizmosFromAllIdeos>true</mergeRitualGizmosFromAllIdeos>
    <useRepeatPenalty>false</useRepeatPenalty>
    <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
    <selectionWeight>0</selectionWeight>
    <classic>true</classic>
  </PreceptDef>

  <RitualPatternDef>
    <defName>WNA_AbilityGrant</defName>
    <alwaysStartAnytime>true</alwaysStartAnytime>
    <ritualObligationTargetFilter>WNA_AbilityGrantTarget</ritualObligationTargetFilter>
    <ritualBehavior>WNA_AbilityGrant</ritualBehavior>
    <ritualOutcomeEffect>WNA_AbilityGrant</ritualOutcomeEffect>
    <ritualOnlyForIdeoMembers>false</ritualOnlyForIdeoMembers>
    <canMergeGizmosFromDifferentIdeos>true</canMergeGizmosFromDifferentIdeos>
    <mergeGizmosForObligations>false</mergeGizmosForObligations>
    <playsIdeoMusic>false</playsIdeoMusic>
  </RitualPatternDef>

  <RitualObligationTargetFilterDef>
    <defName>WNA_AbilityGrantTarget</defName>
    <workerClass>WNA.WNARitual.RitualObligationTargetWorker_AbilityGrant</workerClass>
    <colonistThingsOnly>true</colonistThingsOnly>
  </RitualObligationTargetFilterDef>

  <RitualBehaviorDef>
    <defName>WNA_AbilityGrant</defName>
    <workerClass>WNA.WNARitual.RitualBehaviorWorker_AbilityGrant</workerClass>
    <durationTicks>2500</durationTicks>
    <displayCompletedMessage>false</displayCompletedMessage>
    <spectatorsLabel>spectators</spectatorsLabel>
    <spectatorGerund>spectate</spectatorGerund>
    <spectatorFilter Class="WNA.WNARitual.RitualSpectatorFilter_RecipientOnly">
      <description>Only the recipient may take part in this ritual.</description>
    </spectatorFilter>
    <roles>
      <li Class="WNA.WNARitual.RitualRole_AbilityRecipient">
        <label>recipient</label>
        <missingDesc>a recipient</missingDesc>
        <id>ability_recipient</id>
        <maxCount>1</maxCount>
        <required>true</required>
        <countsAsParticipant>true</countsAsParticipant>
        <defaultForSelectedColonist>true</defaultForSelectedColonist>
        <mustBeAbleToReachTarget>true</mustBeAbleToReachTarget>
      </li>
    </roles>
    <stages>
      <li>
        <defaultDuty>Spectate</defaultDuty>
        <ignoreDurationToFinishAfterStage>true</ignoreDurationToFinishAfterStage>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>1</percentage>
          </li>
        </endTriggers>
        <spectatorsRequired>false</spectatorsRequired>
        <showProgressBar>false</showProgressBar>
        <roleBehaviors>
          <li>
            <roleId>ability_recipient</roleId>
            <dutyDef>Spectate</dutyDef>
            <customPositions>
              <li Class="RitualPosition_BesideThing" />
            </customPositions>
          </li>
        </roleBehaviors>
      </li>
    </stages>
  </RitualBehaviorDef>

  <RitualOutcomeEffectDef>
    <defName>WNA_AbilityGrant</defName>
    <workerClass>WNA.WNARitual.RitualOutcomeEffectWorker_AbilityGrant</workerClass>
    <description>The recipient is granted a new ability of the player's choosing.</description>
    <comps>
      <li Class="WNA.WNARitual.RitualOutcomeComp_AbilityGrant" />
    </comps>
    <outcomeChances>
      <li>
        <label>completed</label>
        <description>The recipient receives the chosen ability.</description>
        <chance>1</chance>
        <positivityIndex>1</positivityIndex>
      </li>
    </outcomeChances>
    <startingQuality>1</startingQuality>
    <minQuality>1</minQuality>
    <maxQuality>1</maxQuality>
    <warnOnLowQuality>false</warnOnLowQuality>
    <allowAttachableOutcome>false</allowAttachableOutcome>
    <allowOutcomeWithNoAttendance>true</allowOutcomeWithNoAttendance>
    <givesDevelopmentPoints>false</givesDevelopmentPoints>
    <extraInfoLines>
      <li>The recipient will gain one ability of your choosing.</li>
    </extraInfoLines>
  </RitualOutcomeEffectDef>

</Defs>
