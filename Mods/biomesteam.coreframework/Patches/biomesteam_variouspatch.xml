<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Biomes! Core</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[modExtensions/li[@Class="BiomesCore.DefModExtensions.Biomes_PlantControl"]]/plant/wildTerrainTags</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[modExtensions/li[@Class="BiomesCore.DefModExtensions.Biomes_PlantControl"]]/plant/wildTerrainTags</xpath>
            <value>
              <li>WNA_Sowable</li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[modExtensions/li[@Class="BiomesCore.DefModExtensions.Biomes_PlantControl"]]/plant</xpath>
            <value>
              <wildTerrainTags>
                <li>WNA_Sowable</li>
              </wildTerrainTags>
            </value>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>